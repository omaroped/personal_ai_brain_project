# Core models
# qwen2.5:7b for engineering/code, deepseek-r1:7b for reasoning
LOCAL_LLM_MODEL=deepseek-r1:7b
EMBED_MODEL=nomic-embed-text:latest
CLOUD_LLM_MODEL=claude-3-5-sonnet-20240620

# Local services
OLLAMA_BASE_URL=http://localhost:11434
LETTA_BASE_URL=http://localhost:8283
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8001

# Optional secrets
ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
LETTA_SERVER_PASSWORD=

# Feature flags
ENABLE_CLOUD_MODELS=false
LOG_LEVEL=INFO
