[Unit]
Description=Personal AI Brain Proactive Monitor
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/personal_ai_brain_project
Environment=PYTHONPATH=%h/personal_ai_brain_project
ExecStart=%h/personal_ai_brain_project/venv/bin/python3 src/agents/proactive.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
